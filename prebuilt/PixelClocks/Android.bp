android_app_import {
    name: "SystemUIClocks-BigNum",
    owner: "google",
    apk: "SystemUIClocks-BigNum.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

