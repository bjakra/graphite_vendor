// Classic Power Menu (Graphite fork, built by tools/apps/build-classic-power-menu.sh). It replaces the
// long-press power menu through SystemUI patch 0510, which falls back to the system menu.
// Platform-signed privileged app, because it holds the permissions the upstream app gets through root.
android_app_import {
    name: "GraphiteClassicPowerMenu",
    apk: "ClassicPowerMenu.apk",
    certificate: "platform",
    privileged: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    system_ext_specific: true,
    required: ["privapp-permissions-classicpowermenu"],
}

prebuilt_etc {
    name: "privapp-permissions-classicpowermenu",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-classicpowermenu.xml",
    filename_from_src: true,
}
