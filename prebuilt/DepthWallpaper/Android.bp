// Graphite's 3D wallpaper (github.com/bjakra/graphite_depth_wallpaper). The APK is about 400 MB with its models,
// too large for this repo: tools/apps/build-depth-wallpaper.sh builds it, downloading the models at pinned, checked
// revisions, and build.sh runs that when the APK is missing. Platform signed and privileged to read the current
// wallpaper and to set itself. Models only run once per picture in its editor; nothing leaves the phone.
android_app_import {
    name: "GraphiteDepthWallpaper",
    apk: "DepthWallpaper.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    required: ["privapp-permissions-depthwallpaper"],
}

prebuilt_etc {
    name: "privapp-permissions-depthwallpaper",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-depthwallpaper.xml",
    filename_from_src: true,
}
