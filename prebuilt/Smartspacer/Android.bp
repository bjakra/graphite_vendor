// Smartspacer (Graphite fork without Firebase or Play Services, built by tools/apps/build-smartspacer.sh).
// Platform-signed privileged app: its "enhanced mode" features run in-process with these permissions
// rather than through Shizuku. Listed apps can also read notifications, see the sysconfig files below.
android_app_import {
    name: "GraphiteSmartspacer",
    apk: "Smartspacer.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    required: [
        "privapp-permissions-smartspacer",
        "sysconfig-smartspacer",
        "default-permissions-smartspacer",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-smartspacer",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-smartspacer.xml",
    filename_from_src: true,
}

// Exempt from battery optimisation, which the setup wizard would otherwise ask for
prebuilt_etc {
    name: "sysconfig-smartspacer",
    system_ext_specific: true,
    sub_dir: "sysconfig",
    src: "sysconfig-smartspacer.xml",
    filename_from_src: true,
}

// Permissions the setup wizard would otherwise ask for
prebuilt_etc {
    name: "default-permissions-smartspacer",
    system_ext_specific: true,
    sub_dir: "default-permissions",
    src: "default-permissions-smartspacer.xml",
    filename_from_src: true,
}
